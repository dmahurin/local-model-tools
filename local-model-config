#!/usr/bin/env python3

from pathlib import Path

from prompt_toolkit import Application
from prompt_toolkit.key_binding import KeyBindings
from prompt_toolkit.layout import HSplit, Layout, Window
from prompt_toolkit.layout.controls import FormattedTextControl
from prompt_toolkit.shortcuts import checkboxlist_dialog, radiolist_dialog
from prompt_toolkit.styles import Style
from prompt_toolkit.widgets import Dialog, Label


CONFIG_FILE = Path.home() / ".local-model-config.env"
DEFAULT_MODEL = "unsloth/gemma-3-4b-it-GGUF:Q4_K_M"

# Keep this list in sync with the model list in start-llm-server. Server-only
# options such as jinja are intentionally not duplicated here.
MODELS = [
    "unsloth/gemma-4-26B-A4B-it-GGUF:MXFP4_MOE",
    "unsloth/Qwen3.5-35B-A3B-GGUF:MXFP4_MOE",
    "bartowski/openai_gpt-oss-20b-GGUF:MXFP4",
    "unsloth/GLM-4.7-Flash-GGUF:MXFP4_MOE",
    "unsloth/Qwen3.5-9B-GGUF:Q4_K_M",
    "unsloth/Qwen3.5-27B-GGUF:Q4_K_M",
    "unsloth/gemma-3-4b-it-GGUF:Q4_K_M",
    "meta-models/Muse-Glimmer-30B-GGUF:muse-glimmer-30B-kquant-dynamic.gguf",
    "bloomer010/Ling-3.0-tiny-GGUF:Q4_K_M",
]


def load_config():
    config = {}
    if CONFIG_FILE.exists():
        for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
            if line and not line.lstrip().startswith("#") and "=" in line:
                name, value = line.split("=", 1)
                config[name] = value
    return config


def save_config(config):
    content = "".join(f"{name}={value}\n" for name, value in config.items())
    CONFIG_FILE.write_text(content, encoding="utf-8")


def choose_one(title, current):
    return radiolist_dialog(
        title=title,
        text="Select a model, then press Enter",
        values=[(model, model) for model in MODELS],
        default=current if current in MODELS else None,
    ).run()


def summarize(models):
    if not models:
        return "none"
    if len(models) == 1:
        return models[0]
    return f"{models[0]} (+{len(models) - 1} more)"


def main_menu(llm_model, vlm_model, server_models):
    items = [
        ("server", f"LLM Server Models: {summarize(server_models)}"),
        ("llm", f"LLM Model: {llm_model}"),
        ("vlm", f"VLM Model: {vlm_model}"),
        ("save", "Done"),
        ("cancel", "Cancel"),
    ]
    selected = 0

    def menu_text():
        return [
            ("class:selected" if index == selected else "", f"  {label}\n")
            for index, (_, label) in enumerate(items)
        ]

    bindings = KeyBindings()

    @bindings.add("up")
    @bindings.add("k")
    def move_up(event):
        nonlocal selected
        selected = (selected - 1) % len(items)
        event.app.invalidate()

    @bindings.add("down")
    @bindings.add("j")
    def move_down(event):
        nonlocal selected
        selected = (selected + 1) % len(items)
        event.app.invalidate()

    @bindings.add("enter")
    def accept(event):
        event.app.exit(result=items[selected][0])

    @bindings.add("escape")
    @bindings.add("c-c")
    def cancel(event):
        event.app.exit(result="cancel")

    menu = Window(
        content=FormattedTextControl(menu_text, focusable=True),
        always_hide_cursor=True,
        height=len(items),
    )
    root = Dialog(
        title="Local Model Configuration",
        body=HSplit([
            Label("Use arrows and press Enter", dont_extend_height=True),
            menu,
        ], padding=1),
        buttons=[],
        with_background=True,
    )
    return Application(
        layout=Layout(root, focused_element=menu),
        key_bindings=bindings,
        style=Style.from_dict({"selected": "reverse"}),
        full_screen=True,
        erase_when_done=True,
    ).run()


def main():
    config = load_config()
    llm_model = config.get("LLM_MODEL", DEFAULT_MODEL)
    vlm_model = config.get("VLM_MODEL", DEFAULT_MODEL)
    server_models = [
        model
        for model in config.get("LLM_SERVER_MODELS", DEFAULT_MODEL).split(",")
        if model
    ]

    while True:
        action = main_menu(llm_model, vlm_model, server_models)

        if action in (None, "cancel"):
            return
        if action == "save":
            config["LLM_MODEL"] = llm_model
            config["VLM_MODEL"] = vlm_model
            config["LLM_SERVER_MODELS"] = ",".join(server_models)
            save_config(config)
            print(f"Saved configuration to {CONFIG_FILE}")
            return
        if action == "server":
            selection = checkboxlist_dialog(
                title="LLM Server Models",
                text="Select models, then press Enter",
                values=[(model, model) for model in MODELS],
                default_values=[model for model in MODELS if model in server_models],
            ).run()
            if selection is not None:
                server_models = selection
        elif action == "llm":
            selection = choose_one("LLM Model", llm_model)
            if selection is not None:
                llm_model = selection
        elif action == "vlm":
            selection = choose_one("VLM Model", vlm_model)
            if selection is not None:
                vlm_model = selection


if __name__ == "__main__":
    main()
