#!/usr/bin/env python3
import os
import sys
from pathlib import Path
from prompt_toolkit.shortcuts import checkboxlist_dialog
import subprocess

CONFIG_FILE = Path.home() / ".local-model-config.env"
DEFAULT_MODEL = "unsloth/gemma-3-4b-it-GGUF:Q4_K_M"

models = [
  {"hf": "unsloth/gemma-4-26B-A4B-it-GGUF:MXFP4_MOE"},
  {"hf": "unsloth/Qwen3.5-35B-A3B-GGUF:MXFP4_MOE"},
  {"hf": "bartowski/openai_gpt-oss-20b-GGUF:MXFP4", "jinja": "on"},
  {"hf": "unsloth/GLM-4.7-Flash-GGUF:MXFP4_MOE"},
  {"hf": "unsloth/Qwen3.5-9B-GGUF:Q4_K_M"},
  {"hf": "unsloth/Qwen3.5-27B-GGUF:Q4_K_M"},
  {"hf": "unsloth/gemma-3-4b-it-GGUF:Q4_K_M"},
]

models_dict = {
  item.get("name") or item.get("hf-repo") or item.get("hf"): {k: v for k, v in item.items() if k != "name"}
  for item in models
}

def load_config():
  config = {}
  if CONFIG_FILE.exists():
    for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
      if line and not line.lstrip().startswith("#") and "=" in line:
        name, value = line.split("=", 1)
        config[name] = value
  return config

def load_selection(config):
  value = os.environ.get("LLM_SERVER_MODELS", config.get("LLM_SERVER_MODELS"))
  if value is not None:
    return [model for model in value.split(",") if model]
  return [DEFAULT_MODEL]

def save_selection(config, selection):
  config["LLM_SERVER_MODELS"] = ",".join(selection)
  CONFIG_FILE.write_text("".join(f"{name}={value}\n" for name, value in config.items()), encoding="utf-8")

def get_selection(prompt, items, previous_selection):
  default_values = [name for name in items if name in previous_selection]
  results = checkboxlist_dialog(text=prompt, values=[(name, name) for name in items], default_values=default_values).run() or []
  return {name: items[name] for name in results}

def get_models_presets(selection):
  result = ''

  for name, model in selection.items():
    model = model.copy()
    if not result:
      #result = "version = 1"
      model['load-on-startup'] = 'on'
    if 'mmproj' in model: del model['mmproj']
    result += f"\n\n[{name}]\n"+'\n'.join([n + '=' + v for n, v in model.items()])
  return result

if __name__ == "__main__":
  config = load_config()
  previous_selection = load_selection(config)
  
  if len(sys.argv) > 1 and sys.argv[1] == '-config':
    selected = get_selection("Select models to use, then press Enter", models_dict, previous_selection)
    save_selection(config, selected.keys())
  else:
    selected = {k: v for k, v in models_dict.items() if k in previous_selection}

  with open("/tmp/models-preset.ini", "w") as f:
    f.write(get_models_presets(selected))
  subprocess.run(['llama-server', '--host', '0.0.0.0', '--models-max', '1', '--models-preset', '/tmp/models-preset.ini'])
