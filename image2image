prompt="$1"
shift
image="$1"

width="$(identify -format "%w" "$image")"
height="$(identify -format "%h" "$image")"

width="$(( $width / 16 * 16 ))"
height="$(( $height / 16 * 16 ))"

convert "$image" -strip -crop "${width}x${height}+0+0" /tmp/a.png

if [ "$width" -lt 200 ]; then
width="$(( $width * 2 ))"
height="$(( $height * 2 ))"
fi

image=/tmp/a.png
mflux-generate-flux2-edit --low-ram --auto-seeds 2  --model `hf download --quiet themindstudio/flux2-klein-4b-mlx-4bit` --image-paths "$@" --prompt "$prompt" --steps 20 --width "$width" --height "$height"
